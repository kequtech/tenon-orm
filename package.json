{
  "name": "@kequtech/tenon-orm",
  "version": "0.1.1",
  "license": "ISC",
  "type": "module",
  "description": "A PostgreSQL ORM designed for coding agents, with explicit SQL, typed queries, and migrations",
  "homepage": "https://github.com/kequtech/tenon-orm#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kequtech/tenon-orm.git"
  },
  "bugs": {
    "url": "https://github.com/kequtech/tenon-orm/issues"
  },
  "keywords": [
    "orm",
    "postgresql",
    "sql",
    "typescript",
    "migrations",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./safeql": {
      "types": "./dist/safeql.d.ts",
      "import": "./dist/safeql.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node .test-dist/test/check-database.js && node --test .test-dist/test/*.test.js",
    "test:consumer": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node --test .test-dist/test/consumer.test.js",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-next": "npm:typescript@^7.0.2",
    "@ts-safeql/eslint-plugin": "^5.4.2",
    "typescript-eslint": "^8.58.0",
    "eslint": "^10.0.0",
    "@ts-safeql/plugin-utils": "^5.3.1"
  },
  "peerDependencies": {
    "pg": "^8.23.1",
    "typescript": ">=6",
    "@ts-safeql/eslint-plugin": "^5.4.2",
    "eslint": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@ts-safeql/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "bin": {
    "tenon": "./dist/cli.js"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
