{
  "name": "@kequtech/tenon-orm",
  "version": "0.4.4",
  "license": "ISC",
  "type": "module",
  "description": "A PostgreSQL ORM designed for coding agents, with explicit SQL, typed queries, and migrations",
  "homepage": "https://github.com/kequtech/tenon-orm#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kequtech/tenon-orm.git"
  },
  "bugs": {
    "url": "https://github.com/kequtech/tenon-orm/issues"
  },
  "keywords": [
    "orm",
    "postgresql",
    "sql",
    "typescript",
    "migrations",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node .test-dist/test/check-database.js && node --test .test-dist/test/*.test.js",
    "test:consumer": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node --test .test-dist/test/consumer.test.js",
    "test:describe": "node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node --test .test-dist/test/describe*.test.js",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript-next": "npm:typescript@^7.0.2"
  },
  "bin": {
    "tenon": "dist/cli.js"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@kequtech/pgclear": "^0.3.0",
    "typescript": "~6.0.2"
  }
}
