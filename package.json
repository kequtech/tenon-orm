{
  "name": "@kequtech/tenon-orm",
  "private": true,
  "version": "0.0.0",
  "license": "ISC",
  "type": "module",
  "description": "An experimental PostgreSQL ORM designed for coding agents",
  "homepage": "https://github.com/kequtech/tenon-orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kequtech/tenon-orm.git"
  },
  "bugs": {
    "url": "https://github.com/kequtech/tenon-orm/issues"
  },
  "keywords": ["postgresql", "sql", "typescript", "migrations", "agents"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node .test-dist/test/check-database.js && node --test .test-dist/test/*.test.js",
    "test:consumer": "npm run build && node node_modules/typescript/bin/tsc -p config/tsconfig.test.json && node --test .test-dist/test/consumer.test.js",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "kequtech": {
    "source": "tenon-orm"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "typescript-minimum": "npm:typescript@5.7.2"
  },
  "peerDependencies": {
    "pg": "^8.23.1",
    "typescript": ">=5.7.2"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true }
  },
  "bin": {
    "tenon": "./dist/cli.js"
  }
}
