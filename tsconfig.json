{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "@kequtech/tenon-orm": ["./src/index.ts"]
    },
    "lib": ["ES2024"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
